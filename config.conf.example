# ACME Manager global preferences. Do not put API keys or SMTP passwords here.
DEFAULT_CA="letsencrypt"
DEFAULT_DNS="cloudflare"
DEFAULT_KEY_TYPE="ec-256"
CERT_DIR="/var/cert"
AUTO_RENEW="true"
NOTIFY_ENABLED="true"
NOTIFY_LEVEL="2"
LOG_DIR="/var/log/acme-manager"
EXPIRY_DAYS="30"
ACME_HOME="/root/.acme.sh"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="tls"
SMTP_FROM=""
SMTP_TO=""
SMTP_USERNAME=""
WEBDAV_ENABLED="false"
WEBDAV_URL=""
WEBDAV_USERNAME=""
