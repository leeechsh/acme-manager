# ACME Manager global preferences. Keep this file mode 600.
DEFAULT_CA="letsencrypt"
DEFAULT_DNS="cloudflare"
DEFAULT_KEY_TYPE="ec-256"
CERT_DIR="/var/cert"
AUTO_RENEW="true"
NOTIFY_ENABLED="true"
NOTIFY_LEVEL="2"
LOG_DIR="/var/log/acme-manager"
EXPIRY_DAYS="30"
ACME_HOME="/root/.acme.sh"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="tls"
SMTP_FROM=""
SMTP_TO=""
SMTP_USERNAME=""
WEBDAV_ENABLED="false"
WEBDAV_URL=""
WEBDAV_USERNAME=""
WEBDAV_PASSWORD=""
AGENT_TARGET_DIR="/var/cert"
AGENT_RELOAD_CMD=""
AGENT_LOG="/var/log/acme-manager/agent.log"
AGENT_CRON_SCHEDULE="*/5 * * * *"
